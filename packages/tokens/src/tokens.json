{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Canonical Lithium primitive tokens.",
  "color": {
    "neutral": {
      "0": { "$type": "color", "$value": "#ffffff" },
      "50": { "$type": "color", "$value": "#f7f7f8" },
      "100": { "$type": "color", "$value": "#eeeeef" },
      "300": { "$type": "color", "$value": "#d7d7da" },
      "500": { "$type": "color", "$value": "#73747c" },
      "700": { "$type": "color", "$value": "#3b3c43" },
      "900": { "$type": "color", "$value": "#202126" },
      "950": { "$type": "color", "$value": "#141519" }
    },
    "blue": {
      "400": { "$type": "color", "$value": "#7d9cff" },
      "600": { "$type": "color", "$value": "#315bd6" }
    },
    "green": { "500": { "$type": "color", "$value": "#147a55" } },
    "amber": { "500": { "$type": "color", "$value": "#9a6700" } },
    "red": { "500": { "$type": "color", "$value": "#bd3636" } }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["SFMono-Regular", "Menlo", "monospace"] }
    },
    "size": {
      "sm": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
      "md": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
      "lg": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" } },
      "xl": { "$type": "dimension", "$value": { "value": 2, "unit": "rem" } }
    },
    "weight": {
      "regular": { "$type": "number", "$value": 400 },
      "medium": { "$type": "number", "$value": 550 },
      "bold": { "$type": "number", "$value": 700 }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.2 },
      "body": { "$type": "number", "$value": 1.6 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": { "value": 0.25, "unit": "rem" } },
    "2": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
    "3": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } },
    "4": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
    "6": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" } },
    "8": { "$type": "dimension", "$value": { "value": 2, "unit": "rem" } },
    "12": { "$type": "dimension", "$value": { "value": 3, "unit": "rem" } }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": { "value": 0.25, "unit": "rem" } },
    "md": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
    "lg": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } },
    "full": { "$type": "dimension", "$value": { "value": 999, "unit": "px" } }
  },
  "border": { "width": { "default": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } } } },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": { "color": "#14151914", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
    }
  },
  "opacity": { "disabled": { "$type": "number", "$value": 0.5 } },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": { "value": 120, "unit": "ms" } },
      "normal": { "$type": "duration", "$value": { "value": 200, "unit": "ms" } }
    },
    "ease": { "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] } }
  },
  "size": {
    "control": { "$type": "dimension", "$value": { "value": 2.5, "unit": "rem" } },
    "content": { "$type": "dimension", "$value": { "value": 72, "unit": "rem" } }
  },
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": { "value": 40, "unit": "rem" } },
    "lg": { "$type": "dimension", "$value": { "value": 64, "unit": "rem" } }
  },
  "zIndex": {
    "base": { "$type": "number", "$value": 0 },
    "overlay": { "$type": "number", "$value": 100 },
    "toast": { "$type": "number", "$value": 200 }
  }
}
