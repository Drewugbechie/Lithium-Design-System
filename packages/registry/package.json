{
  "name": "@lithium/registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --import tsx scripts/build-registry.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./data": {
      "types": "./dist/registry/v1/data.d.ts",
      "import": "./dist/registry/v1/data.js"
    },
    "./search-index": "./dist/registry/v1/search-index.json"
  },
  "files": ["dist"]
}
